{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meado-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],

	// Fase 6: Hyperdrive real, apunta a la misma Supabase de siempre (no
	// cambia el proveedor de DB, solo cómo Workers se conecta a él).
	// env.DATABASE_URL sigue existiendo como secret separado, usado solo
	// como fallback local en wrangler dev cuando no hay binding real.
	"hyperdrive": [
		{ "binding": "HYPERDRIVE", "id": "9ea8ba718f374ff080aacf2ab092d1f6" }
	],

	// Vars no sensibles (los secrets van vía `wrangler secret put`, no aquí)
	"vars": {
		"NODE_ENV": "production",
		"FRONTEND_URL": "https://meado.es",
		"CORS_ORIGIN": "https://meado.es,https://www.meado.es",
		"RESEND_FROM": "noreply@meado.es",
		"CLOUDINARY_CLOUD_NAME": "dgmfwo7rj",
		"GOOGLE_DRIVE_FOLDER_ID": "1fsNEXf41LCm7zVZmK74VWyw6BWYsBNZQ",
		"LIVEKIT_URL": "wss://meado-s8fy59to.livekit.cloud"
	},

	// api.meado.es reemplaza la URL workers.dev expuesta al cliente (WS directo
	// y proxy /api/* del frontend).
	"routes": [{ "pattern": "api.meado.es", "custom_domain": true }],
	"workers_dev": false,

	"durable_objects": {
		"bindings": [
			{ "name": "CHANNEL_DO", "class_name": "ChannelDO" },
			{ "name": "DM_DO", "class_name": "DmDO" },
			{ "name": "USER_REGISTRY_DO", "class_name": "UserRegistryDO" },
			{ "name": "RATE_LIMITER_DO", "class_name": "RateLimiterDO" }
		]
	},
	"migrations": [
		{
			// Todavía sin desplegar a Cloudflare real — se puede seguir
			// añadiendo a "v1" en vez de una migración "v2" separada mientras
			// no haya nada en producción que migrar.
			"tag": "v1",
			"new_sqlite_classes": ["ChannelDO", "DmDO", "UserRegistryDO", "RateLimiterDO"]
		}
	]
}
